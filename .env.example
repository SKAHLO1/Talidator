# Talidator web app — environment variables.
# Local: copy to .env.local.  Vercel: Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are inlined at build time: redeploy after changing them.

# ── Monad testnet ────────────────────────────────────────────────────────────
# Explicit RPC override (e.g. a local fork). Leave empty to use Alchemy (below) or the public RPC.
NEXT_PUBLIC_MONAD_RPC_URL=

# ── Alchemy (sponsor) — Monad testnet node ───────────────────────────────────
# Server-only key. Server code calls Alchemy directly; with the proxy flag, browsers read through /api/rpc
# (read-only allowlist) so the key never ships to the client.
ALCHEMY_API_KEY=
# Set to true together with ALCHEMY_API_KEY (the proxy answers 503 without a key).
NEXT_PUBLIC_USE_ALCHEMY_PROXY=
# eth_getLogs block range for the RPC fallback indexer (Alchemy free tier: 10; Monad public RPC: 100).
# Only used when no Envio indexer is configured.
NEXT_PUBLIC_LOG_CHUNK_SIZE=10

# ── Envio HyperIndex (sponsor) ───────────────────────────────────────────────
# GraphQL endpoint of the deployed indexer (../indexer → Envio Cloud). When set, the dashboard reads indexed
# state from Envio instead of scanning event logs. e.g. https://indexer.hyperindex.xyz/<id>/v1/graphql
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=

# ── Qwen 3.8 Max (sponsor) — AI auditor agent (/api/audit) ───────────────────
QWEN_API_KEY=
# QWEN_BASE_URL=https://maas.qwencloudapi.com/compatible-mode/v1
# QWEN_MODEL=qwen3.8-max
# Minimum confidence for /api/audit/flags (read by the Chainlink CRE keeper to hold flagged payouts)
# AUDIT_FLAG_MIN_CONFIDENCE=0.8

# ── Validator daemon ─────────────────────────────────────────────────────────
# Public URL of the daemon (e.g. https://talidator-daemon.onrender.com). The app pings its /health when a
# validation or challenge is submitted, waking a free Render service that sleeps after 15 idle minutes.
NEXT_PUBLIC_DAEMON_URL=

# Contract addresses. Set all six (or none — then src/lib/chain/deployments.ts from `npm run deploy:monad` is used).
NEXT_PUBLIC_IDENTITY_REGISTRY=
NEXT_PUBLIC_VALIDATOR_STAKING=
NEXT_PUBLIC_VALIDATION_REGISTRY=
NEXT_PUBLIC_ESCROW=
NEXT_PUBLIC_CHALLENGE_MARKET=
NEXT_PUBLIC_REPUTATION_REGISTRY=
# Block the contracts were deployed at — event history is indexed from here.
NEXT_PUBLIC_DEPLOY_BLOCK=

# ── Firebase (accounts: per-user dashboards, watchlist, labels, alerts) ──────
# Without these the app still works as a public on-chain dashboard; sign-in is hidden.
# Web app config: Firebase console → Project settings → General → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Admin credentials: Project settings → Service accounts → Generate new private key.
# Paste the key with literal \n line breaks, on one line, wrapped in double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Domain users sign in on (SIWE). Recommended in production, e.g. talidator.vercel.app (no scheme).
# Falls back to the request's Host header.
SIWE_DOMAIN=

# ── Local Firebase emulators (development only; never set these on Vercel) ───
# npx firebase-tools emulators:start --only auth,firestore --project demo-talidator
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
