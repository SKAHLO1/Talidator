# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (every workspace: root, contracts, indexer, cre)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# firebase emulators
*-debug.log
.firebase/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Firebase service-account keys (never commit)
*-firebase-adminsdk-*.json

# Chainlink CRE build output
.cre_build_tmp.js

# Foundry broadcast logs (addresses live in contracts/deployments/)
contracts/broadcast/

# Claude Code per-user settings
.claude/settings.local.json
AGENTS.MD
CLAUDE.MD
