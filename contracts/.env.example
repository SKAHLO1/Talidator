# Copy to contracts/.env — never commit the real file.

# Deployer / operator (relayer, keeper, arbiter, escrow client). Needs testnet MON on Monad.
PRIVATE_KEY=

# Agent accounts derived from this mnemonic at HD indexes 1–9 (traders always; validators + challenger unless
# Privy is configured below). Use a FRESH mnemonic: anvil's public "test test … junk" accounts carry EIP-7702
# sweeper delegations on Monad testnet that drain any MON sent to them.
MNEMONIC=

# ── Alchemy (sponsor) — Monad testnet RPC for the agents ──────────────────────
# Used automatically when set (RPC_URL still wins). https://dashboard.alchemy.com → create app → Monad Testnet.
ALCHEMY_API_KEY=

# ── Privy (sponsor) — server wallets for validator + challenger agents ────────
# With these set, validators/challenger get Privy-managed wallets bound to role policies (only Talidator votes,
# bonds, reviews, challenges on Monad testnet; capped values; everything else denied). Dashboard → App settings.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# PRIVY_MAX_BOND=1             # policy cap per bond / challenge tx, in MON

# ── Qwen 3.8 Max (sponsor) — autonomous auditor agent ─────────────────────────
# AUDITOR=on lets the daemon audit finalized results and challenge ones the agent is confident are wrong.
QWEN_API_KEY=
# QWEN_BASE_URL=https://maas.qwencloudapi.com/compatible-mode/v1
# QWEN_MODEL=qwen3.8-max
# AUDITOR=on
# AUDITOR_MIN_CONFIDENCE=0.8

# ── Chainlink CRE (sponsor) ───────────────────────────────────────────────────
# KEEPER=off hands escrow settlement + reputation posting to the CRE workflow (cre/talidator-keeper).
# KEEPER=off
# CRE_FORWARDERS=0x..,0x..    # KeeperReceiver forwarders (defaults: Monad testnet simulation + production)

# Optional overrides
# RPC_URL=https://testnet-rpc.monad.xyz
# DEMO_PAYMENT=0.01           # escrowed per demo trade
# AGENT_GAS_BUFFER=0.03       # MON kept in each agent account for gas
# COLLUDING=Alpha,Beta        # validators the daemon runs dishonestly
# POLL_MS=2500

# Deploy parameters (wei / seconds / bps) — defaults shown
# MIN_BOND=100000000000000000          # 0.1
# CHALLENGE_BOND=50000000000000000     # 0.05
# VOTING_PERIOD=1800
# CHALLENGE_WINDOW=600
# REVIEW_PERIOD=300
# UNBONDING_PERIOD=86400
# SLASH_BPS=3000
# CHALLENGER_CUT_BPS=5000
